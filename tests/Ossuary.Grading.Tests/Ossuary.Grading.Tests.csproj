<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ossuary.Grading\Ossuary.Grading.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="codex-cards-v26.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The tests run against the table the mod actually ships, linked from its home
    rather than copied. A fixture that drifted from the bundle would assert the
    curve holds for data nobody installs.
  -->
  <ItemGroup>
    <None Include="../../src/Ossuary/Data/ratings.tsv"
          Link="ratings.tsv"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
