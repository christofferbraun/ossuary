<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>fetch-codex-data</AssemblyName>
    <RootNamespace>Ossuary.Tools.FetchCodexData</RootNamespace>
    <!-- Build-time only. Never staged, never shipped, never loaded by the game. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    References the same grading library the mod ships, on purpose: the tiers
    baked into the bundle are then produced by the exact code that would have
    produced them at runtime, and the tests that assert the curve are asserting
    something about the shipped artifact rather than about a parallel
    implementation that could drift.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ossuary.Grading\Ossuary.Grading.csproj" />
  </ItemGroup>

</Project>
